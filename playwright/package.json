{
  "name": "clash-royale-playwright-audit",
  "version": "1.0.0",
  "description": "Isolated E2E, UI/UX, Accessibility, and Security tests for Clash Royale Deck Analytics",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:functional": "playwright test tests/functional.spec.ts",
    "test:security": "playwright test tests/security.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:perf": "playwright test tests/performance.spec.ts",
    "report": "playwright show-report reports"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "axe-playwright": "^2.0.1",
    "typescript": "^5.3.3",
    "@types/node": "^20.11.24"
  }
}
